# Firebase Web App config (Project Settings > General > Your apps > SDK setup and configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Cloud Messaging Web Push certificate (Project Settings > Cloud Messaging > Web Push certificates)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Optional: enables "Upload from device" for the admin Landing Images gallery
# (/admin/landing-images). Without these, admins can still paste any https://
# image URL directly — this only adds a convenience upload button.
#
# Cloud Name: shown on your Cloudinary dashboard home page.
# Upload Preset: Cloudinary Console > Settings > Upload > Upload presets >
#   Add upload preset > set "Signing Mode" to "Unsigned" > Save. Use the
#   preset's name here (not its ID). An UNSIGNED preset is required — this
#   app is a static export with no server, so it can never hold the API
#   Secret a signed upload would need. Do NOT put the API Key or API Secret
#   in any NEXT_PUBLIC_* variable; neither is used or needed here.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Only used by scripts/seed.ts (server-side, never bundled to the client).
# Path to a Firebase service account JSON key (Project Settings > Service Accounts > Generate new private key).
# NEVER commit the actual key file.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
